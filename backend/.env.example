# Sovaris - OTA Validation Platform
# Rename this file to .env before running

# OpenAI (free tier)
OPENAI_API_KEY=sk-your-key-here

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# LLM Router thresholds
# Risk score above this value triggers OpenAI instead of Ollama
COMPLEXITY_THRESHOLD=0.7
# Max tokens before switching to Ollama to protect free tier
OPENAI_DAILY_TOKEN_LIMIT=40000

# ChromaDB
CHROMA_PERSIST_DIR=./data/vector_store

# App
APP_ENV=development
LOG_LEVEL=INFO
